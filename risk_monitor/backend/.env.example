# CelesTrak TLE feeds (the default active/debris endpoints can be changed per deployment)
CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements
CELESTRAK_SATELLITES_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=active&FORMAT=tle
CELESTRAK_DEBRIS_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=cosmos-1408-debris&FORMAT=tle
CELESTRAK_CACHE_SECONDS=900
REQUEST_TIMEOUT_SECONDS=20
DATABASE_URL=sqlite:///./orbitkeep.db
MONITOR_ENABLED=false
MONITOR_INTERVAL_SECONDS=300
PREDICTION_WINDOW_MINUTES=60
SAMPLING_INTERVAL_SECONDS=30
HIGH_RISK_DISTANCE_KM=1
MEDIUM_RISK_DISTANCE_KM=5
DUPLICATE_TOLERANCE_SECONDS=300
MAX_CANDIDATES_PER_SATELLITE=75
